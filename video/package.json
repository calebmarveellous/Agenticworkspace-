{
  "name": "group-chat-diagnostic-manual-video",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "remotion studio",
    "build:a": "remotion render PromoVerticalA out/promo-vertical-a.mp4",
    "build:b": "remotion render PromoVerticalB out/promo-vertical-b.mp4",
    "build:c": "remotion render PromoVerticalC out/promo-vertical-c.mp4",
    "build:all": "npm run build:a && npm run build:b && npm run build:c",
    "build:square:a": "remotion render PromoSquareA out/promo-square-a.mp4",
    "build:square:b": "remotion render PromoSquareB out/promo-square-b.mp4",
    "build:square:c": "remotion render PromoSquareC out/promo-square-c.mp4",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@remotion/cli": "4.0.286",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.286"
  },
  "devDependencies": {
    "@types/react": "18.3.11",
    "typescript": "5.6.3"
  }
}
